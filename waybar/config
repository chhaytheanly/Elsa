{
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "tray",
        "hyprland/language",
        "cpu",
        "backlight",
        "pulseaudio",
        "battery",
        "network",
        "custom/power"
    ],

    "custom/launcher": {
        "format": " ",
        "on-click": "rofi -show drun",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": " ",
            "2": " ",
            "3": " ",
            "4": " ",
            "5": " ",
            "urgent": " ",
            "active": " ",
            "default": " "
        },
        "sort-by-number": true,
        "active-only": false,
        "all-outputs": false,
        "on-click": "activate",
        "disable-scroll": false,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "hyprland/window": {
        "format": "[{title}]",
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%a %H:%M}",
        "format-alt": "{:%d %B %Y}",
        "interval": 10,
        "tooltip-format": "{:%A, %d %B %Y  %H:%M}"
    },

    "cpu": {
        "interval": 5,
        "format": "{usage}% 󰍛",
        "on-click": "alacritty -e btop",
        "tooltip-format": "CPU: {usage}%  Load: {load}"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "{ifname} 󰀂",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP: {ipaddr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "IP: {ipaddr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "nospacing": 1,
        "on-click": "alacritty -e nmtui"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "default": [" ", " ", " "]
        },
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{volume}% | {desc}"
    },

    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["󰃊 ", "󰃝 ", "󰃟 ", "󰃠 "],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": true
    },

    "hyprland/language": {
        "format": "{short}",
        "format-us": "EN",
        "format-kh": "KH",
        "tooltip": false
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰢜",
        "format-plugged": "{capacity}% 󰂄",
        "format-full": "{capacity}% 󰂅",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 5,    
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip-format": "{capacity}%  {time}"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 12,
        "show-passive": false
    },

    "custom/power": {
        "format": "󰐥 ",
        "on-click": "/mnt/d/dotfile/hypr/scripts/powermenu.sh",
        "tooltip": false
    }
}