{
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 0,
    "reload_style_on_change": true,

    // Left: launcher, workspaces, active window
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    // Center: clock
    "modules-center": [
        "clock"
    ],
    // Right: tray, network, cpu, audio, battery, power
    "modules-right": [
        "tray",
        "cpu",
        "pulseaudio",
        "battery",
        "network",
        "custom/power"
    ],

    // Launcher icon -> rofi
    "custom/launcher": {
        "format": "󰘳 ",
        "on-click": "rofi -show drun",
        "tooltip": false
    },

    // Workspaces: number-only pills
    "hyprland/workspaces": {
        "format": "{icon}",
        "sort-by-number": true,
        "active-only": false,
        "all-outputs": false,
        "on-click": "activate",
        "disable-scroll": false,
        "persistent_workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    // Active window title
    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    // Clock: day + time
    "clock": {
        "format": "{:%a %H:%M}",
        "format-alt": "{:%d %B %Y}",
        "interval": 10,
        "tooltip-format": "{:%A, %d %B %Y  %H:%M}"
    },

    // CPU
    "cpu": {
        "interval": 5,
        "format": "{usage}% 󰍛",
        "on-click": "alacritty -e btop",
        "tooltip-format": "CPU: {usage}%  Load: {load}"
    },

    // Network
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "{ifname} 󰀂",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP: {ipaddr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "IP: {ipaddr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "nospacing": 1,
        "on-click": "alacritty -e nmtui"
    },

    // Audio
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{volume}% | {desc}"
    },

    // Battery
    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰢜",
        "format-plugged": "{capacity}% 󰂄",
        "format-full": "{capacity}% 󰂅",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip-format": "{capacity}%  {time}"
    },

    // System tray
    "tray": {
        "icon-size": 16,
        "spacing": 12,
        "show-passive": false
    },

    // Power menu -> rofi
    "custom/power": {
        "format": "󰐥 ",
        "on-click": "~/.config/waybar/rofi-power.sh",
        "tooltip": false
    }
}
